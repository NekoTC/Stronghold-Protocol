# Tencent Cloud COS Upload Configuration Example
# Copy this file to .env.cos and fill in your credentials

# Required: COS bucket name
export SP_OBJECT_STORAGE_BUCKET="your-bucket-name"

# Required: Tencent Cloud credentials
export TENCENTCLOUD_SECRET_ID="your-secret-id"
export TENCENTCLOUD_SECRET_KEY="your-secret-key"

# Optional: COS region (default: ap-shanghai)
export SP_COS_REGION="ap-chongqing"

# Optional: Path prefix in bucket (e.g., "v0.1.3" or "prod")
export SP_OBJECT_STORAGE_PREFIX="v0.1.3"

# Optional: CDN URLs for assets and data
export SP_ASSET_BASE_URL="https://cdn.example.com/assets"
export SP_DATA_BASE_URL="https://cdn.example.com/data"

# Usage:
# 1. Copy this file: cp cos-config.sh.example .env.cos
# 2. Edit .env.cos with your credentials
# 3. Load variables: source .env.cos
# 4. Run upload: node tools/upload-to-cos.mjs
